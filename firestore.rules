rules_version = '2';

// Lecturas públicas (letras/acordes no son datos sensibles).
// Todas las escrituras pasan exclusivamente por las funciones Netlify
// (Firebase Admin SDK), que ignoran estas reglas — por eso aquí se bloquean
// por completo desde el cliente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
