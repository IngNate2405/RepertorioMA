rules_version = '2';

// Lecturas públicas solo para las colecciones que de verdad no son sensibles
// (letras/acordes, setlists). Todas las escrituras pasan exclusivamente por
// funciones serverless (Firebase Admin SDK, que ignora estas reglas) — por eso
// aquí se bloquean por completo desde el cliente.
//
// `config` (PINs de acceso) queda fuera a propósito: nada de lectura ni
// escritura desde el cliente, ni siquiera de un documento suelto — si esto
// fuera parte del catch-all de abajo, cualquiera podría leer los PINs desde
// la consola del navegador con el SDK cliente de Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/{document=**} {
      allow read: if false;
      allow write: if false;
    }
    match /songs/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /setlists/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
