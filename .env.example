# Variables de servidor (funciones Netlify) — NO llevan prefijo VITE_,
# el cliente nunca las ve. Para desarrollo local con `netlify dev`, copia
# este archivo a `.env` y rellena los valores.

# PINs de acceso (6+ caracteres alfanuméricos recomendado)
ADMIN_PIN=
USER_PIN=

# Google AI Studio (gratis) → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Credenciales de la cuenta de servicio de Firebase (Firebase Console →
# Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
